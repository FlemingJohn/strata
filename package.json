{
  "name": "strata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A top down action game where your proven Ethereum history becomes your character",
  "scripts": {
    "start": "vite",
    "buildForProduction": "vite build",
    "previewProduction": "vite preview",
    "checkTypes": "tsc --noEmit",
    "compileContracts": "hardhat compile",
    "deployContracts": "hardhat run scripts/deployContracts.ts --network creditcoinTestnet",
    "proveOneTransaction": "tsx scripts/proveOneTransaction.ts"
  },
  "dependencies": {
    "@gluwa/usc-sdk": "^1.0.0",
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
